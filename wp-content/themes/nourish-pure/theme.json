{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Nourish & Pure",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "base",
          "color": "#FFFFFF",
          "name": "Pure White (Base Background)"
        },
        {
          "slug": "contrast",
          "color": "#1E221E",
          "name": "Deep Charcoal (Text)"
        },
        {
          "slug": "secondary-text",
          "color": "#6B726A",
          "name": "Earth Grey (Secondary Text)"
        },
        {
          "slug": "primary-accent",
          "color": "#44624A",
          "name": "Sage Olive (Accent)"
        },
        {
          "slug": "secondary-accent",
          "color": "#C27852",
          "name": "Terracotta (Action)"
        },
        {
          "slug": "border",
          "color": "#EBE5DC",
          "name": "Soft Oat (Borders)"
        },
        {
          "slug": "surface",
          "color": "#FFFFFF",
          "name": "White Surface (Cards)"
        },
        {
          "slug": "highlight",
          "color": "#F0F2EB",
          "name": "Subtle Highlight (Sage Tint)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Fraunces, 'Playfair Display', 'Iowan Old Style', 'Apple Garamond', 'Baskerville', 'Times New Roman', serif",
          "name": "Editorial Serif",
          "slug": "serif"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "name": "Clean Sans",
          "slug": "sans"
        },
        {
          "fontFamily": "ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace",
          "name": "Monospace",
          "slug": "monospace"
        }
      ],
      "fontSizes": [
        {
          "name": "Metadata",
          "slug": "x-small",
          "size": "0.8125rem"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "0.9375rem"
        },
        {
          "name": "Body (18px)",
          "slug": "normal",
          "size": "1.125rem"
        },
        {
          "name": "Medium (H4)",
          "slug": "medium",
          "size": "1.3125rem"
        },
        {
          "name": "Large (H3)",
          "slug": "large",
          "size": "clamp(1.35rem, 2vw, 1.625rem)"
        },
        {
          "name": "Extra Large (H2)",
          "slug": "x-large",
          "size": "clamp(1.5625rem, 2.5vw, 2.25rem)"
        },
        {
          "name": "Display (H1)",
          "slug": "xx-large",
          "size": "clamp(2rem, 4vw, 3.25rem)"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"],
      "spacingSizes": [
        { "name": "Tiny (8px)", "slug": "10", "size": "0.5rem" },
        { "name": "X-Small (16px)", "slug": "20", "size": "1rem" },
        { "name": "Small (24px)", "slug": "30", "size": "1.5rem" },
        { "name": "Medium (32px)", "slug": "40", "size": "2rem" },
        { "name": "Large (48px)", "slug": "50", "size": "3rem" },
        { "name": "X-Large (64px)", "slug": "60", "size": "4rem" },
        { "name": "2X-Large (96px)", "slug": "70", "size": "6rem" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.75"
    },
    "spacing": {
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-accent)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.28"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.35"
        }
      },
      "button": {
        "color": {
          "text": "var(--wp--preset--color--base)",
          "background": "var(--wp--preset--color--primary-accent)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        },
        "border": {
          "radius": "4px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "text": "#ffffff"
          },
          "background": "#36503b"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "1.75rem",
          "fontWeight": "700",
          "letterSpacing": "-0.01em"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "var(--wp--preset--font-size--x-small)",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--secondary-text)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "0.9375rem",
          "fontWeight": "500"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--primary-accent)"
              }
            }
          }
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--normal)",
          "lineHeight": "1.6"
        },
        "color": {
          "text": "var(--wp--preset--color--secondary-text)"
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)"
        },
        "color": {
          "text": "var(--wp--preset--color--secondary-text)"
        }
      },
      "core/post-author-name": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-small)",
          "fontWeight": "600",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--primary-accent)"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--primary-accent)",
            "width": "3px"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontStyle": "italic",
          "fontSize": "var(--wp--preset--font-size--medium)"
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          },
          "margin": {
            "top": "2rem",
            "bottom": "2rem"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "top": {
            "color": "var(--wp--preset--color--border)",
            "width": "1px"
          },
          "bottom": {
            "color": "var(--wp--preset--color--border)",
            "width": "1px"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.35"
        },
        "spacing": {
          "padding": {
            "top": "2rem",
            "bottom": "2rem"
          }
        }
      },
      "core/separator": {
        "border": {
          "color": "var(--wp--preset--color--border)",
          "width": "1px"
        },
        "color": {
          "text": "var(--wp--preset--color--border)"
        }
      },
      "core/table": {
        "border": {
          "color": "var(--wp--preset--color--border)",
          "width": "1px"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  }
}
